# Documentation only: PHP does NOT load this file automatically.
# Supply values through process/Apache environment. A private file works only if the Host explicitly exports its values to PHP; this app does not load it.
MRNEON_PUBLIC_BASE_URL=
MRNEON_TELEGRAM_BOT_TOKEN=
MRNEON_TELEGRAM_ADMIN_CHAT_ID=
MRNEON_TELEGRAM_NOTIFIER_BOT=
# Public Bot identity and webhook authentication. Use only a new/private value; never commit real secrets.
MRNEON_TELEGRAM_BOT_USERNAME=
MRNEON_TELEGRAM_WEBHOOK_SECRET=
# SMTP: encryption must be starttls (typically 587) or smtps (typically 465); clear-text SMTP is unsupported.
MRNEON_EMAIL_HOST=
MRNEON_EMAIL_PORT=
MRNEON_EMAIL_USERNAME=
MRNEON_EMAIL_PASSWORD=
MRNEON_EMAIL_ENCRYPTION=
MRNEON_EMAIL_FROM_ADDRESS=
MRNEON_EMAIL_FROM_NAME=
# Required explicit EHLO identity: a valid FQDN or bracketed IP address-literal.
# Do not use .local/.invalid or derive this automatically from the From address.
MRNEON_EMAIL_HELO_NAME=
MRNEON_EMAIL_TIMEOUT_SECONDS=10
MRNEON_EMAIL_TLS_CA_FILE=

# MariaDB/MySQL via PDO. Empty passwords are loopback-only and require explicit local opt-in.
MRNEON_DB_HOST=127.0.0.1
MRNEON_DB_PORT=3306
MRNEON_DB_NAME=mrneon_dev
MRNEON_DB_USER=mrneon_local
# MRNEON_DB_PASSWORD is intentionally unset here; provide it only through the hosting environment.
MRNEON_DB_CHARSET=utf8mb4
MRNEON_DB_CONNECT_TIMEOUT=5
MRNEON_DB_SSL_CA=
# Remote hosts require a readable CA file; TLS certificate verification is enforced.
MRNEON_DB_REQUIRE_TLS=0
MRNEON_DB_ALLOW_EMPTY_PASSWORD=0
# Dedicated private HMAC key for rate-limit bucket identity; generate 32+ random bytes.
MRNEON_RATE_LIMIT_HMAC_KEY=
# Separate private key for OTP HMACs and keyed destination fingerprints (32+ random bytes).
MRNEON_OTP_HMAC_KEY=
# Reset-only authorization lifetime; OTP itself remains fixed at 120 seconds.
MRNEON_RECOVERY_TOKEN_TTL_SECONDS=600

# Optional recovery rate-limit overrides.
# Defaults are defined in app/http/middleware/RateLimitMiddleware.php.
MRNEON_RECOVERY_START_IP_LIMIT_PER_HOUR=20
MRNEON_RECOVERY_START_IDENTITY_LIMIT_PER_HOUR=5
MRNEON_RECOVERY_VERIFY_IP_LIMIT_PER_HOUR=60
MRNEON_RECOVERY_VERIFY_CHALLENGE_LIMIT_PER_HOUR=15
MRNEON_RECOVERY_RESET_IP_LIMIT_PER_HOUR=30
MRNEON_RECOVERY_RESET_TOKEN_LIMIT_PER_HOUR=10
MRNEON_OTP_MAX_ATTEMPTS=5
MRNEON_OTP_RESEND_COOLDOWN_SECONDS=60
MRNEON_OTP_MAX_RESENDS=3
MRNEON_OTP_SEND_IP_LIMIT_PER_HOUR=20
MRNEON_OTP_RESEND_IP_LIMIT_PER_HOUR=20
MRNEON_OTP_VERIFY_IP_LIMIT_PER_HOUR=60
MRNEON_OTP_SEND_ATTEMPT_LIMIT_PER_HOUR=8
MRNEON_OTP_RESEND_ATTEMPT_LIMIT_PER_HOUR=8
MRNEON_OTP_VERIFY_ATTEMPT_LIMIT_PER_HOUR=30
MRNEON_OTP_DESTINATION_LIMIT_PER_HOUR=5
# Approved, server-owned legal document version; leave empty until Terms/Privacy are formally approved.
MRNEON_TERMS_VERSION=
# Temporary registration-attempt lifetime; independent from the 120-second OTP challenge lifetime.
MRNEON_REGISTRATION_ATTEMPT_TTL_SECONDS=1800
MRNEON_REGISTRATION_WINDOW_SECONDS=3600
MRNEON_REGISTRATION_IP_LIMIT=10
MRNEON_REGISTRATION_USERNAME_LIMIT=5
MRNEON_REGISTRATION_PHONE_LIMIT=5
MRNEON_REGISTRATION_DESTINATION_LIMIT=5
# Local-development sample only; never copy this environment value into Production.
MRNEON_ENV=local
# CSP reporting is staging-only and non-enforcing; keep disabled until a staged review is approved.
MRNEON_CSP_REPORT_ONLY=0
# Optional approved HTTPS report collector; no collector is bundled or activated by default.
MRNEON_CSP_REPORT_URI=
# Local-development sample only. Production requires HTTPS and Secure cookies (set this to 1).
MRNEON_SESSION_COOKIE_SECURE=0
MRNEON_SESSION_IDLE_TIMEOUT=1800
MRNEON_SESSION_ABSOLUTE_TIMEOUT=86400
MRNEON_ADMIN_USERNAME=
# Stable opaque admin inbox ID; keep independent of username/password/TOTP and do not rotate with login credentials.
MRNEON_ADMIN_INBOX_ID=
MRNEON_ADMIN_PASSWORD_HASH=
MRNEON_ADMIN_TOTP_SECRET=

# Absolute private path outside the project/document root; do not point this into the repository.
MRNEON_BACKUP_DIR=

# Authentication rate-limit policy (environment variables are read by PHP at runtime).
MRNEON_LOGIN_IP_LIMIT=20
MRNEON_LOGIN_ACCOUNT_LIMIT=8
MRNEON_LOGIN_WINDOW_SECONDS=300
MRNEON_ADMIN_LOGIN_IP_LIMIT=8
MRNEON_ADMIN_LOGIN_ACCOUNT_LIMIT=5
MRNEON_ADMIN_LOGIN_WINDOW_SECONDS=300

# Public session bootstrap/status limits (DB-backed; per remote IP)
MRNEON_SESSION_STATUS_IP_LIMIT=60
MRNEON_SESSION_STATUS_WINDOW_SECONDS=60
MRNEON_LOGOUT_IP_LIMIT=30
MRNEON_LOGOUT_WINDOW_SECONDS=60

# Idempotency retention cleanup is disabled unless an operator explicitly enables a single CLI invocation.
# The command also requires --apply and --confirm-db=<exact configured DB name>; do not enable routinely before QA/owner approval.
MRNEON_ALLOW_IDEMPOTENCY_CLEANUP=0
# Set only after the real final QA gate and separate owner approval have completed.
MRNEON_IDEMPOTENCY_CLEANUP_QA_APPROVED=0
# Required separately if and only if an explicitly authorized cleanup targets MRNEON_ENV=production.
MRNEON_ALLOW_PRODUCTION_IDEMPOTENCY_CLEANUP=0
