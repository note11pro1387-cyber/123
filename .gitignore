# Local/private environment and configuration (never commit real values)
.env
.env.*
!/.env.example
/config/config.local.php
/config.local.php
*.local.php
*.private.php
.secrets/
secrets/
private-config/

# Runtime/user data: ignore new additions; this does not untrack files already committed
/data/*.json
/data/*.log
/data/*.log.*
/data/*.sqlite
/data/*.sqlite-*
/data/*.sqlite3
/data/*.db
/data/*.db-*
/data/*.db3
/data/sessions/
/data/backups/
sessions/

# Logs, backups, exports, temporary files and local diagnostics
*.log
*.log.*
logs/
backups/
exports/
*.bak
*.backup
*.old
*.tmp
*.temp
*.orig
*.rej
*.swp
*.swo
*~
.#*
*.dump
*.sql.gz
*.zip.bak
*.tar.bak
*.tgz.bak

# Raw SQL dumps/database exports are private; keep versioned migrations tracked.
*.sql
!/database/migrations/
!/database/migrations/*.sql
!/database/migrations/**/*.sql
*.sqlite
*.sqlite-*
*.sqlite3
*.db
*.db-*
*.db3
*.mdb
*.ibd
*.frm
*.myd
*.myi

# Private keys and keystores. Do not ignore public CA PEM certificates globally.
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
id_dsa
*-private.pem
*_private.pem
*-key.pem
*_key.pem
private.pem
privkey.pem
id_rsa.pem
id_ed25519.pem
id_ecdsa.pem
id_dsa.pem
private-*.pem
private_*.pem
*-privkey.pem
*_privkey.pem
*.privkey.pem
*.private.pem

# PHP/Node dependency, generated build and test-coverage outputs
/vendor/
node_modules/
dist/
build/
/.phpunit.cache/
.phpunit.cache/
/coverage/
coverage/
.nyc_output/
.pytest_cache/
__pycache__/
*.py[cod]
*.lcov

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local database and private database-operation artifacts (keep SQL migrations tracked)
/database/backups/
/database/runtime/
*.ndjson.gz
*.ndjson.gz.sha256
/wave2-report-private/
